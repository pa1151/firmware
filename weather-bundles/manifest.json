{
  "schema_version": 1,
  "manifest_version": "1.0.0",
  "repo_path": "weather-bundles",
  "mapping_reference": "WMO_MAPPING.md",
  "required_runtime_files": [
    "sunny.jpg",
    "partly_cloudy.jpg",
    "cloudy.jpg",
    "foggy.jpg",
    "rainy.jpg",
    "snowy.jpg",
    "thunderstorm.jpg",
    "night_clear.jpg",
    "night_cloudy.jpg",
    "digits.jpg"
  ],
  "wmo_slots": [
    {
      "slot": "clear",
      "day_file": "sunny.jpg",
      "night_file": "night_clear.jpg",
      "wmo_codes": [0],
      "description": "Clear sky"
    },
    {
      "slot": "partly_cloudy",
      "day_file": "partly_cloudy.jpg",
      "night_file": "night_cloudy.jpg",
      "wmo_codes": [1, 2],
      "description": "Mainly clear and partly cloudy"
    },
    {
      "slot": "overcast",
      "day_file": "cloudy.jpg",
      "night_file": "night_cloudy.jpg",
      "wmo_codes": [3],
      "description": "Overcast"
    },
    {
      "slot": "fog",
      "day_file": "foggy.jpg",
      "night_file": "foggy.jpg",
      "wmo_codes": [45, 48],
      "description": "Fog and depositing rime fog"
    },
    {
      "slot": "rain",
      "day_file": "rainy.jpg",
      "night_file": "rainy.jpg",
      "wmo_codes": [51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82],
      "description": "Drizzle, rain, freezing rain, and showers"
    },
    {
      "slot": "snow",
      "day_file": "snowy.jpg",
      "night_file": "snowy.jpg",
      "wmo_codes": [71, 73, 75, 77, 85, 86],
      "description": "Snow, snow grains, and snow showers"
    },
    {
      "slot": "thunderstorm",
      "day_file": "thunderstorm.jpg",
      "night_file": "thunderstorm.jpg",
      "wmo_codes": [95, 96, 99],
      "description": "Thunderstorm and thunderstorm with hail"
    }
  ],
  "bundles": [
    {
      "name": "cartoon",
      "display_name": "Cartoon",
      "description": "Illustrated cartoon-style weather backgrounds",
      "version": "1.0.0",
      "manifest_path": "cartoon/manifest.json",
      "base_url": "https://raw.githubusercontent.com/pa1151/firmware/main/weather-bundles/cartoon",
      "file_count": 10
    },
    {
      "name": "realistic",
      "display_name": "Realistic",
      "description": "Photorealistic weather backgrounds",
      "version": "1.0.0",
      "manifest_path": "realistic/manifest.json",
      "base_url": "https://raw.githubusercontent.com/pa1151/firmware/main/weather-bundles/realistic",
      "file_count": 10
    }
  ]
}
